[Unit]
Description=YT Jukebox - internal YouTube music player (Volumio-style)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/yt-jukebox
Environment=NODE_ENV=production
Environment=PORT=80
Environment=HOST=0.0.0.0

# Cổng dưới 1024 vốn chỉ root mới bind được. Thay vì chạy bằng root, cấp đúng
# một quyền CAP_NET_BIND_SERVICE. Đã kiểm chứng: quyền này vẫn hiệu lực cùng
# NoNewPrivileges=true bên dưới.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/node /opt/yt-jukebox/server.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# Hardening (an toàn cơ bản)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
